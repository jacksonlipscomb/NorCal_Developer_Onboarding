# Frontend build-time config (Vite embeds VITE_* into the bundle at build time).
# Copy to .env.local for local dev; inject the same values into the build environment
# for deploys (CI/CD or your shell when running `npm run pages:deploy`).
#
# These are the PUBLIC Supabase values — safe to ship in the browser bundle.
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-anon-key>
